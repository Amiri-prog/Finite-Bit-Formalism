import Mathlib.Data.Finset.Basic
import Mathlib.Data.Finset.Card
import Mathlib.Data.Set.Basic
import Mathlib.Basic.Real.Basic
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Basic
import Mathlib.Tactic
import Mathlib.Algebra.Group.Action.Basic
import Mathlib.GroupTheory.Solvable
import Mathlib.Logic.Relation


-- ============================================
-- PART 1: BASIC FBF OBJECTS
-- ============================================

universe u

structure Bit where
  id : ℕ
  deriving DecidableEq, Repr

abbrev InformationSet := Finset Bit

def BitContent (B : InformationSet) : ℕ :=
  B.card


-- A formal mathematical object consists of
-- its type together with its particular value.
structure FObject where
  Obj : Type u
  val : Obj


-- ============================================
-- PART 2: INFORMATION STRUCTURE
-- ============================================

class InformationStructure where
  Realizes :
    FObject →
    InformationSet →
    Prop


class BitDependency where
  Dependent :
    Bit →
    InformationSet →
    Prop


def Independent
    [BitDependency]
    (b : Bit)
    (B : InformationSet) : Prop :=
  ¬ BitDependency.Dependent b B


def IndependentSet
    [BitDependency]
    (B : InformationSet) : Prop :=
  ∀ b, b ∈ B →
    Independent b (B \ {b})


-- B specifies s when B realizes s and
-- determines that entity uniquely.
def Specifies
    [InformationStructure]
    (B : InformationSet)
    (s : FObject) : Prop :=
  InformationStructure.Realizes s B ∧
  ∀ s' : FObject,
    InformationStructure.Realizes s' B →
    s' = s


-- A minimal bit representation specifies the entity,
-- consists of independent bits, and loses the
-- specification if any bit is removed.
def MinimalBits
    [InformationStructure]
    [BitDependency]
    (B : InformationSet)
    (s : FObject) : Prop :=
  Specifies B s ∧
  IndependentSet B ∧
  ∀ b, b ∈ B →
    ¬ Specifies (B \ {b}) s


-- ============================================
-- PART 3: ADJOINING INFORMATION
-- ============================================

def Adjoin
    (B : InformationSet)
    (b : Bit) : InformationSet :=
  insert b B


def AdjoinSet
    (B A : InformationSet) : InformationSet :=
  B ∪ A


-- Original weaker definition retained for
-- compatibility with earlier formalized proofs.
def AdjoinedBits
    (B A : InformationSet) : Prop :=
  A ∩ B = ∅ ∧
  A ≠ ∅


-- Refined notion:
-- A is a minimal determining set of independent
-- adjoined bits relative to the existing set B.
--
-- B ∪ A uniquely determines the entity s,
-- while no proper subset of A does so.
def DeterminingAdjoinedBits
    [InformationStructure]
    [BitDependency]
    (B A : InformationSet)
    (s : FObject) : Prop :=
  A ∩ B = ∅ ∧
  A ≠ ∅ ∧

  (∀ b, b ∈ A →
    Independent b (B ∪ (A \ {b}))) ∧

  Specifies (AdjoinSet B A) s ∧

  (∀ A' : InformationSet,
    A' ⊆ A →
    A' ≠ A →
    ¬ Specifies (AdjoinSet B A') s)


-- Every refined determining adjoined set
-- is also an adjoined set in the original sense.
theorem determiningAdjoinedBits_implies_adjoinedBits
    [InformationStructure]
    [BitDependency]
    {B A : InformationSet}
    {s : FObject}
    (h : DeterminingAdjoinedBits B A s) :
    AdjoinedBits B A := by
  exact ⟨h.1, h.2.1⟩


-- ============================================
-- PART 4: INFORMATION EQUIVALENCE
-- ============================================

class InformationEquivalence where
  Equivalent :
    FObject →
    InformationSet →
    InformationSet →
    Prop


def EquivalentSet
    [InformationEquivalence]
    (s : FObject)
    (B₁ B₂ : InformationSet) : Prop :=
  InformationEquivalence.Equivalent s B₁ B₂


def PreservesInformation
    (B₁ B₂ : InformationSet) : Prop :=
  BitContent B₁ = BitContent B₂


-- A null operation changes representation
-- without changing information content.
def NullOperation
    [InformationEquivalence]
    (s : FObject)
    (B₁ B₂ : InformationSet) : Prop :=
  EquivalentSet s B₁ B₂ ∧
  PreservesInformation B₁ B₂


-- E is a minimal independent representative of the
-- equivalent information generated by adjoining A to B.
--
-- The same existing information B is retained on both
-- sides of the equivalence.
def MinimalEquivalentBits
    [InformationEquivalence]
    [BitDependency]
    (s : FObject)
    (B A E : InformationSet) : Prop :=
  EquivalentSet s
      (AdjoinSet B A)
      (AdjoinSet B E) ∧

  IndependentSet E ∧

  ∀ E' : InformationSet,
    E' ⊆ E →
    E' ≠ E →
    ¬ EquivalentSet s
        (AdjoinSet B A)
        (AdjoinSet B E')


-- ============================================
-- PART 5: FBF AXIOM 1
-- ============================================

class FBF_Axiom1
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence] where

  minimal_representation :
    ∀ (s : FObject),
      ∃ B : InformationSet,
        MinimalBits B s

  equivalent_refl :
    ∀ (s : FObject)
      (B : InformationSet),
      EquivalentSet s B B

  equivalent_symm :
    ∀ (s : FObject)
      (B₁ B₂ : InformationSet),
      EquivalentSet s B₁ B₂ →
      EquivalentSet s B₂ B₁

  equivalent_trans :
    ∀ (s : FObject)
      (B₁ B₂ B₃ : InformationSet),
      EquivalentSet s B₁ B₂ →
      EquivalentSet s B₂ B₃ →
      EquivalentSet s B₁ B₃

  null_preserves_content :
    ∀ (s : FObject)
      (B₁ B₂ : InformationSet),
      NullOperation s B₁ B₂ →
      BitContent B₁ = BitContent B₂


-- ============================================
-- PART 6: REFINED FBF AXIOM 1
-- ============================================

class FBF_Axiom1_Refined
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence]
    extends FBF_Axiom1 where

  equivalent_preserves_content :
    ∀ (s : FObject)
      (B₁ B₂ : InformationSet),
      EquivalentSet s B₁ B₂ →
      PreservesInformation B₁ B₂

  minimal_representations_equivalent :
    ∀ (s : FObject)
      (B₁ B₂ : InformationSet),
      MinimalBits B₁ s →
      MinimalBits B₂ s →
      EquivalentSet s B₁ B₂

  realizations_equivalent :
    ∀ (s : FObject)
      (B₁ B₂ : InformationSet),
      InformationStructure.Realizes s B₁ →
      InformationStructure.Realizes s B₂ →
      EquivalentSet s B₁ B₂


-- ============================================
-- PART 7: ORIGINAL FBF AXIOM 3
-- Retained for compatibility with earlier proofs
-- ============================================

class FBF_Axiom3
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence] where

  emergence :
    ∀ (s : FObject)
      (B A : InformationSet),
      MinimalBits B s →
      AdjoinedBits B A →
      ∃! (E : InformationSet),
        E ≠ B ∧
        EquivalentSet s
          (AdjoinSet B A)
          E

  adjoined_count : ℕ

  equivalent_count : ℕ

  count_eq :
    adjoined_count = equivalent_count


-- ============================================
-- PART 8: REFINED FBF AXIOM 3
-- ============================================

class FBF_Axiom3_Refined
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence] where

  -- Abstract type of emergent theorems.
  EmergentTheoremType : Type

  -- An emergent theorem relates:
  --   the entity s,
  --   the existing information B,
  --   the minimal determining adjoined set A,
  --   and a minimal equivalent representation E.
  Relates :
    EmergentTheoremType →
    FObject →
    InformationSet →
    InformationSet →
    InformationSet →
    Prop

  -- A minimal equivalent representation emerges from
  -- a minimal determining adjoined set.
  emergence :
    ∀ (s : FObject)
      (B A : InformationSet),
      DeterminingAdjoinedBits B A s →
      ∃ E : InformationSet,
        MinimalEquivalentBits s B A E

  -- Bit balance:
  -- the minimal determining adjoined set and every
  -- minimal equivalent representation have the same
  -- cardinality.
  bit_balance :
    ∀ (s : FObject)
      (B A E : InformationSet),
      DeterminingAdjoinedBits B A s →
      MinimalEquivalentBits s B A E →
      BitContent A = BitContent E

  -- The emergent theorem is unique for the entire
  -- equivalent class, rather than for one particular
  -- equivalent representative.
  emergent_theorem_unique :
    ∀ (s : FObject)
      (B A : InformationSet),
      DeterminingAdjoinedBits B A s →
      ∃! T : EmergentTheoremType,
        ∀ E : InformationSet,
          MinimalEquivalentBits s B A E →
          Relates T s B A E


-- ============================================
-- PART 9: CONSEQUENCES OF REFINED AXIOM 3
-- ============================================

-- Bit balance:
-- |A_min| = |E_min|.
theorem FBF_bit_balance
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence]
    [FBF_Axiom3_Refined]
    {s : FObject}
    {B A E : InformationSet}
    (hA : DeterminingAdjoinedBits B A s)
    (hE : MinimalEquivalentBits s B A E) :
    BitContent A = BitContent E :=
  FBF_Axiom3_Refined.bit_balance
    s B A E hA hE


-- Interchangeability:
-- B ∪ A and B ∪ E are equivalent representations
-- of the same entity, and equivalence holds in both
-- directions.
theorem FBF_minimal_equivalent_interchange
    [InformationStructure]
    [InformationEquivalence]
    [BitDependency]
    [FBF_Axiom1]
    {s : FObject}
    {B A E : InformationSet}
    (hE : MinimalEquivalentBits s B A E) :
    EquivalentSet s
        (AdjoinSet B A)
        (AdjoinSet B E) ∧
    EquivalentSet s
        (AdjoinSet B E)
        (AdjoinSet B A) := by
  constructor
  · exact hE.1
  · exact FBF_Axiom1.equivalent_symm
      s
      (AdjoinSet B A)
      (AdjoinSet B E)
      hE.1


-- ============================================
-- PART 10: BASIC CHECKS
-- ============================================

#check FBF_Axiom1
#check FBF_Axiom1_Refined
#check FBF_Axiom3

#check DeterminingAdjoinedBits
#check MinimalEquivalentBits
#check FBF_Axiom3_Refined

#check FBF_bit_balance
#check FBF_minimal_equivalent_interchange
