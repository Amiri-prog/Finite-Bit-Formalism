import FBF_Core

import Mathlib.Algebra.Group.Action.Basic
import Mathlib.GroupTheory.Solvable
import Mathlib.Logic.Relation

-- ============================================
-- PART 11: ADJOINED-BIT MONOIDS AND SYMMETRY
-- ============================================

universe v

-- The atomic bits belonging to a particular
-- adjoined-bit configuration A.
abbrev AdjoinedAtom
    (A : InformationSet) :=
  { b : Bit // b ∈ A }


-- The idempotent commutative monoid generated by A
-- is represented by finite accumulated subsets of A.
--
-- Composition is union.
abbrev AdjoinedBitMonoid
    (A : InformationSet) :=
  Finset (AdjoinedAtom A)


def AdjoinedJoin
    {A : InformationSet}
    (X Y : AdjoinedBitMonoid A) :
    AdjoinedBitMonoid A :=
  X ∪ Y


theorem adjoinedJoin_comm
    {A : InformationSet}
    (X Y : AdjoinedBitMonoid A) :
    AdjoinedJoin X Y =
    AdjoinedJoin Y X := by
  simp [AdjoinedJoin, Finset.union_comm]


theorem adjoinedJoin_assoc
    {A : InformationSet}
    (X Y Z : AdjoinedBitMonoid A) :
    AdjoinedJoin (AdjoinedJoin X Y) Z =
    AdjoinedJoin X (AdjoinedJoin Y Z) := by
  simp [AdjoinedJoin, Finset.union_assoc]


theorem adjoinedJoin_idempotent
    {A : InformationSet}
    (X : AdjoinedBitMonoid A) :
    AdjoinedJoin X X = X := by
  simp [AdjoinedJoin]


theorem adjoinedJoin_empty
    {A : InformationSet}
    (X : AdjoinedBitMonoid A) :
    AdjoinedJoin ∅ X = X := by
  simp [AdjoinedJoin]


-- An FBF bit-symmetry structure:
-- G acts on the atomic adjoined bits.
--
-- Faithfulness means that two different governing
-- symmetries cannot induce exactly the same action
-- on all adjoined bits.
structure FBFBitSymmetry
    (A : InformationSet)
    (G : Type v)
    [Group G] where

  action :
    G →* Equiv.Perm (AdjoinedAtom A)

  faithful :
    Function.Injective action


namespace FBFBitSymmetry

-- Extend the action from atomic bits to accumulated
-- information in the adjoined-bit monoid.
def actOnMonoid
    {A : InformationSet}
    {G : Type v}
    [Group G]
    (S : FBFBitSymmetry A G)
    (g : G)
    (X : AdjoinedBitMonoid A) :
    AdjoinedBitMonoid A :=
  X.map (S.action g).toEmbedding


-- Symmetry preserves monoid composition.
theorem actOnMonoid_union
    {A : InformationSet}
    {G : Type v}
    [Group G]
    (S : FBFBitSymmetry A G)
    (g : G)
    (X Y : AdjoinedBitMonoid A) :
    S.actOnMonoid g (X ∪ Y) =
      S.actOnMonoid g X ∪
      S.actOnMonoid g Y := by
  ext x
  simp [actOnMonoid]

end FBFBitSymmetry

-- ============================================
-- PART 12: ISOMORPHISM OF BIT-SYMMETRY STRUCTURES
-- ============================================

structure FBFBitSymmetryIso
    {A C : InformationSet}
    {G H : Type v}
    [Group G]
    [Group H]
    (S₁ : FBFBitSymmetry A G)
    (S₂ : FBFBitSymmetry C H) where

  -- Correspondence of atomic adjoined bits.
  bitEquiv :
    AdjoinedAtom A ≃ AdjoinedAtom C

  -- Correspondence of governing symmetry groups.
  groupEquiv :
    G ≃* H

  -- The bit correspondence respects the group action.
  equivariant :
    ∀ (g : G) (b : AdjoinedAtom A),
      bitEquiv (S₁.action g b) =
        S₂.action (groupEquiv g) (bitEquiv b)


-- Solvability is preserved by symmetry-group
-- isomorphism.
theorem group_solvable_iff_of_mulEquiv
    {G H : Type v}
    [Group G]
    [Group H]
    (e : G ≃* H) :
    Group.IsSolvable G ↔
    Group.IsSolvable H := by
  constructor

  · intro hG
    exact
      @Group.isSolvable_of_surjective
        G H
        inferInstance
        inferInstance
        e.toMonoidHom
        e.surjective
        hG

  · intro hH
    exact
      @Group.isSolvable_of_surjective
        H G
        inferInstance
        inferInstance
        e.symm.toMonoidHom
        e.symm.surjective
        hH

-- ============================================
-- PART 13: ADMISSIBLE CONSTRUCTIONS
-- AND CONSTRUCTIVE REVERSIBILITY
-- ============================================

-- Primitive admissible operations are deliberately
-- kept abstract. Geometry, Galois theory, number
-- theory, etc. may instantiate them differently.
structure FBFConstructionSystem where

  Step :
    FObject →
    InformationSet →
    InformationSet →
    Prop


-- A finite sequence of admissible FBF operations.
def FBFReachable
    (C : FBFConstructionSystem)
    (s : FObject)
    (B₁ B₂ : InformationSet) : Prop :=
  Relation.ReflTransGen
    (C.Step s)
    B₁
    B₂


-- Reverse reconstruction of the adjoined bits from
-- an equivalent representation.
def ConstructivelyReversible
    (C : FBFConstructionSystem)
    (s : FObject)
    (B A E : InformationSet) : Prop :=
  FBFReachable
    C
    s
    (AdjoinSet B E)
    (AdjoinSet B A)


-- Biconditionality of an emergent FBF relation.
--
-- Forward emergence is represented by the existing
-- DeterminingAdjoinedBits / MinimalEquivalentBits
-- machinery.  The additional requirement is an
-- admissible reverse construction.
def ConstructivelyBiconditional
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence]
    (C : FBFConstructionSystem)
    (s : FObject)
    (B A E : InformationSet) : Prop :=

  DeterminingAdjoinedBits B A s ∧
  MinimalEquivalentBits s B A E ∧
  ConstructivelyReversible C s B A E

  -- ============================================
-- PART 14:
-- STRUCTURAL TRANSPORT OF FBF BICONDITIONALITY
-- ============================================

/-
Part IIa of the FBF correspondence.

The purpose of this section is NOT to assume that
biconditionality is preserved.

Instead we define an isomorphism of the primitive FBF
construction structures:

  * complete information sets correspond,
  * adjoining information is preserved,
  * determining adjoined-bit structure is preserved,
  * minimal equivalent-bit structure is preserved,
  * every primitive admissible construction step is
    preserved in both directions.

From these primitive preservation laws Lean derives
preservation of finite constructions, reversibility,
and finally biconditionality.
-/


structure FBFConstructionIso
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence]
    (C₁ C₂ : FBFConstructionSystem)
    (s₁ s₂ : FObject) where

  -- Correspondence between the complete information
  -- sets of the two FBF realizations.
  infoEquiv :
    InformationSet ≃ InformationSet

  -- The correspondence respects accumulation/adjoining
  -- of information.
  adjoin_map :
    ∀ X Y : InformationSet,
      infoEquiv (AdjoinSet X Y) =
        AdjoinSet (infoEquiv X) (infoEquiv Y)

  -- The determining adjoined-bit structure is preserved.
  determining_iff :
    ∀ B A : InformationSet,
      DeterminingAdjoinedBits B A s₁ ↔
      DeterminingAdjoinedBits
        (infoEquiv B)
        (infoEquiv A)
        s₂

  -- The minimal equivalent-bit structure is preserved.
  minimalEquivalent_iff :
    ∀ B A E : InformationSet,
      MinimalEquivalentBits s₁ B A E ↔
      MinimalEquivalentBits
        s₂
        (infoEquiv B)
        (infoEquiv A)
        (infoEquiv E)

  -- Primitive admissible construction steps are
  -- preserved in both directions.
  step_iff :
    ∀ X Y : InformationSet,
      C₁.Step s₁ X Y ↔
      C₂.Step s₂
        (infoEquiv X)
        (infoEquiv Y)


namespace FBFConstructionIso


-- --------------------------------------------
-- 14.1 Forward transport of finite constructions
-- --------------------------------------------

theorem reachable_forward
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence]
    {C₁ C₂ : FBFConstructionSystem}
    {s₁ s₂ : FObject}
    (I : FBFConstructionIso C₁ C₂ s₁ s₂)
    {X Y : InformationSet}
    (h :
      FBFReachable C₁ s₁ X Y) :
    FBFReachable
      C₂
      s₂
      (I.infoEquiv X)
      (I.infoEquiv Y) := by

  have hStep :
      (C₁.Step s₁) ≤
        Function.onFun
          (C₂.Step s₂)
          I.infoEquiv := by
    intro U V hUV
    exact (I.step_iff U V).mp hUV

  exact
    (Relation.ReflTransGen.lift
      I.infoEquiv
      hStep)
      X Y h

-- --------------------------------------------
-- 14.2 Reverse transport of finite constructions
-- --------------------------------------------

theorem reachable_backward
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence]
    {C₁ C₂ : FBFConstructionSystem}
    {s₁ s₂ : FObject}
    (I : FBFConstructionIso C₁ C₂ s₁ s₂)
    {X Y : InformationSet}
    (h :
      FBFReachable
        C₂
        s₂
        (I.infoEquiv X)
        (I.infoEquiv Y)) :
    FBFReachable C₁ s₁ X Y := by

  have hStepBack :
      (C₂.Step s₂) ≤
        Function.onFun
          (C₁.Step s₁)
          I.infoEquiv.symm := by
    intro U V hUV

    apply
      (I.step_iff
        (I.infoEquiv.symm U)
        (I.infoEquiv.symm V)).mpr

    simpa using hUV

  have hLift :
      FBFReachable
        C₁
        s₁
        (I.infoEquiv.symm (I.infoEquiv X))
        (I.infoEquiv.symm (I.infoEquiv Y)) := by

    exact
      (Relation.ReflTransGen.lift
        I.infoEquiv.symm
        hStepBack)
        (I.infoEquiv X)
        (I.infoEquiv Y)
        h

  simpa using hLift

-- --------------------------------------------
-- 14.3 Finite construction equivalence
-- --------------------------------------------

theorem reachable_iff
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence]
    {C₁ C₂ : FBFConstructionSystem}
    {s₁ s₂ : FObject}
    (I : FBFConstructionIso C₁ C₂ s₁ s₂)
    (X Y : InformationSet) :
    FBFReachable C₁ s₁ X Y ↔
    FBFReachable
      C₂
      s₂
      (I.infoEquiv X)
      (I.infoEquiv Y) := by

  constructor

  · intro h
    exact reachable_forward I h

  · intro h
    exact reachable_backward I h


-- --------------------------------------------
-- 14.4 Constructive reversibility is invariant
-- --------------------------------------------

theorem constructivelyReversible_iff
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence]
    {C₁ C₂ : FBFConstructionSystem}
    {s₁ s₂ : FObject}
    (I : FBFConstructionIso C₁ C₂ s₁ s₂)
    (B A E : InformationSet) :
    ConstructivelyReversible
        C₁ s₁ B A E
      ↔
    ConstructivelyReversible
        C₂
        s₂
        (I.infoEquiv B)
        (I.infoEquiv A)
        (I.infoEquiv E) := by

  unfold ConstructivelyReversible

  have hReach :=
    reachable_iff
      I
      (AdjoinSet B E)
      (AdjoinSet B A)

  simpa only
    [I.adjoin_map B E,
     I.adjoin_map B A]
    using hReach


-- --------------------------------------------
-- 14.5 Biconditionality of a fixed emergent
--      representative is invariant
-- --------------------------------------------

theorem constructivelyBiconditional_iff
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence]
    {C₁ C₂ : FBFConstructionSystem}
    {s₁ s₂ : FObject}
    (I : FBFConstructionIso C₁ C₂ s₁ s₂)
    (B A E : InformationSet) :
    ConstructivelyBiconditional
        C₁ s₁ B A E
      ↔
    ConstructivelyBiconditional
        C₂
        s₂
        (I.infoEquiv B)
        (I.infoEquiv A)
        (I.infoEquiv E) := by

  constructor

  · intro h

    rcases h with
      ⟨hA, hE, hRev⟩

    exact
      ⟨
        (I.determining_iff B A).mp hA,
        (I.minimalEquivalent_iff B A E).mp hE,
        (constructivelyReversible_iff
          I B A E).mp hRev
      ⟩

  · intro h

    rcases h with
      ⟨hA, hE, hRev⟩

    exact
      ⟨
        (I.determining_iff B A).mpr hA,
        (I.minimalEquivalent_iff B A E).mpr hE,
        (constructivelyReversible_iff
          I B A E).mpr hRev
      ⟩


end FBFConstructionIso


-- ============================================
-- PART 14.6:
-- BICONDITIONALITY OF THE EMERGENT CLASS
-- ============================================

/-
Axiom 3 concerns an entire emergent equivalent class,
not one arbitrarily chosen representative E.

Accordingly, define biconditionality of the emergent
configuration by existence of a minimal equivalent
representative admitting a constructive reverse.
-/

def EmergentBiconditional
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence]
    (C : FBFConstructionSystem)
    (s : FObject)
    (B A : InformationSet) : Prop :=
  ∃ E : InformationSet,
    ConstructivelyBiconditional
      C s B A E


-- Structural invariance of biconditionality for the
-- whole emergent equivalent class.
theorem FBF_biconditionality_invariant
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence]
    {C₁ C₂ : FBFConstructionSystem}
    {s₁ s₂ : FObject}
    (I : FBFConstructionIso C₁ C₂ s₁ s₂)
    (B A : InformationSet) :
    EmergentBiconditional C₁ s₁ B A
      ↔
    EmergentBiconditional
      C₂
      s₂
      (I.infoEquiv B)
      (I.infoEquiv A) := by

  constructor

  · intro h

    rcases h with
      ⟨E, hE⟩

    refine
      ⟨I.infoEquiv E, ?_⟩

    exact
      (FBFConstructionIso.constructivelyBiconditional_iff
        I B A E).mp hE

  · intro h

    rcases h with
      ⟨E₂, hE₂⟩

    refine
      ⟨I.infoEquiv.symm E₂, ?_⟩

    apply
      (FBFConstructionIso.constructivelyBiconditional_iff
        I
        B
        A
        (I.infoEquiv.symm E₂)).mpr

    simpa using hE₂


-- ============================================
-- PART 14.7:
-- CONNECTION WITH REFINED AXIOM 3
-- ============================================

/-
Axiom 3 guarantees that a determining adjoined-bit
configuration has at least one minimal equivalent
representative.

This theorem records that fact explicitly for later
use in the Galois realization.
-/

theorem FBF_emergent_equivalent_exists
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence]
    [FBF_Axiom3_Refined]
    {s : FObject}
    {B A : InformationSet}
    (hA :
      DeterminingAdjoinedBits B A s) :
    ∃ E : InformationSet,
      MinimalEquivalentBits
        s B A E := by

  exact
    FBF_Axiom3_Refined.emergence
      s B A hA


-- ============================================
-- PART 14.8:
-- BASIC CHECKS
-- ============================================

-- ============================================
-- PART 15:
-- FBF SYMMETRY--BICONDITIONALITY
-- STRUCTURAL TRANSFER
-- ============================================

/-
Part 15 combines:

  Part 12:
    invariance of group solvability under
    symmetry-group isomorphism,

with

  Part 14:
    invariance of constructive biconditionality
    under construction-structure isomorphism.

No assertion is made here that solvability itself
causes biconditionality.

Instead, we prove the structural transfer statement:

If one realization satisfies

      G solvable ↔ emergent theorem biconditional,

then every structurally corresponding FBF realization
satisfies the same criterion.
-/


-- A complete correspondence contains both:
--
--   (1) the governing bit-symmetry correspondence,
--   (2) the admissible-construction correspondence.
--
-- The compatibility condition says that both
-- correspondences identify the same atomic bits.
structure FBFStructuralCorrespondence
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence]
    {A₁ A₂ : InformationSet}
    {G₁ G₂ : Type v}
    [Group G₁]
    [Group G₂]
    (S₁ : FBFBitSymmetry A₁ G₁)
    (S₂ : FBFBitSymmetry A₂ G₂)
    (C₁ C₂ : FBFConstructionSystem)
    (s₁ s₂ : FObject) where

  symmetryIso :
    FBFBitSymmetryIso S₁ S₂

  constructionIso :
    FBFConstructionIso C₁ C₂ s₁ s₂

  -- The bit correspondence used by the symmetry
  -- structure agrees with the information-set
  -- correspondence on atomic singleton bits.
  atom_compatible :
    ∀ b : AdjoinedAtom A₁,
      constructionIso.infoEquiv {b.1} =
        {(symmetryIso.bitEquiv b).1}


namespace FBFStructuralCorrespondence


-- --------------------------------------------
-- 15.1 Solvability transport
-- --------------------------------------------

theorem solvable_iff
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence]
    {A₁ A₂ : InformationSet}
    {G₁ G₂ : Type v}
    [Group G₁]
    [Group G₂]
    {S₁ : FBFBitSymmetry A₁ G₁}
    {S₂ : FBFBitSymmetry A₂ G₂}
    {C₁ C₂ : FBFConstructionSystem}
    {s₁ s₂ : FObject}
    (R :
      FBFStructuralCorrespondence
        S₁ S₂ C₁ C₂ s₁ s₂) :
    Group.IsSolvable G₁ ↔
    Group.IsSolvable G₂ := by

  exact
    group_solvable_iff_of_mulEquiv
      R.symmetryIso.groupEquiv


-- --------------------------------------------
-- 15.2 Biconditionality transport
-- --------------------------------------------

theorem biconditional_iff
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence]
    {A₁ A₂ : InformationSet}
    {G₁ G₂ : Type v}
    [Group G₁]
    [Group G₂]
    {S₁ : FBFBitSymmetry A₁ G₁}
    {S₂ : FBFBitSymmetry A₂ G₂}
    {C₁ C₂ : FBFConstructionSystem}
    {s₁ s₂ : FObject}
    (R :
      FBFStructuralCorrespondence
        S₁ S₂ C₁ C₂ s₁ s₂)
    (B A : InformationSet) :
    EmergentBiconditional
        C₁ s₁ B A
      ↔
    EmergentBiconditional
        C₂
        s₂
        (R.constructionIso.infoEquiv B)
        (R.constructionIso.infoEquiv A) := by

  exact
    FBF_biconditionality_invariant
      R.constructionIso
      B A


end FBFStructuralCorrespondence


-- ============================================
-- PART 15.3:
-- SOLVABILITY--BICONDITIONALITY CRITERION
-- ============================================

/-
This is the abstract structural property that is
realized classically in Galois theory.

It deliberately does NOT define biconditionality
to mean solvability.

The left and right sides have already been defined
independently:

  Group.IsSolvable
      -- ordinary group theory

  EmergentBiconditional
      -- finite admissible FBF reconstruction

The proposition below merely states that a particular
realization satisfies an equivalence between them.
-/

def SolvabilityBiconditionalCriterion
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence]
    (G : Type v)
    [Group G]
    (C : FBFConstructionSystem)
    (s : FObject)
    (B A : InformationSet) : Prop :=

  Group.IsSolvable G ↔
  EmergentBiconditional C s B A


-- ============================================
-- PART 15.4:
-- MAIN STRUCTURAL TRANSFER THEOREM
-- ============================================

theorem FBF_solvability_biconditionality_transfer
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence]
    {A₁ A₂ : InformationSet}
    {G₁ G₂ : Type v}
    [Group G₁]
    [Group G₂]
    {S₁ : FBFBitSymmetry A₁ G₁}
    {S₂ : FBFBitSymmetry A₂ G₂}
    {C₁ C₂ : FBFConstructionSystem}
    {s₁ s₂ : FObject}
    (R :
      FBFStructuralCorrespondence
        S₁ S₂ C₁ C₂ s₁ s₂)
    (B A : InformationSet) :

    SolvabilityBiconditionalCriterion
        G₁ C₁ s₁ B A
      ↔
    SolvabilityBiconditionalCriterion
        G₂
        C₂
        s₂
        (R.constructionIso.infoEquiv B)
        (R.constructionIso.infoEquiv A) := by

  unfold SolvabilityBiconditionalCriterion

  have hSolv :
      Group.IsSolvable G₁ ↔
      Group.IsSolvable G₂ :=
    FBFStructuralCorrespondence.solvable_iff R

  have hBicond :
      EmergentBiconditional C₁ s₁ B A
        ↔
      EmergentBiconditional
        C₂
        s₂
        (R.constructionIso.infoEquiv B)
        (R.constructionIso.infoEquiv A) :=
    FBFStructuralCorrespondence.biconditional_iff
      R B A

  tauto


-- ============================================
-- PART 15.5:
-- FORWARD TRANSFER FORM
-- ============================================

/-
This is the form we shall use with Galois theory:

If realization 1 has already established

      G₁ solvable ↔ biconditionality,

then the structurally corresponding realization 2
inherits the same theorem.
-/

theorem FBF_transfer_from_reference_realization
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence]
    {A₁ A₂ : InformationSet}
    {G₁ G₂ : Type v}
    [Group G₁]
    [Group G₂]
    {S₁ : FBFBitSymmetry A₁ G₁}
    {S₂ : FBFBitSymmetry A₂ G₂}
    {C₁ C₂ : FBFConstructionSystem}
    {s₁ s₂ : FObject}
    (R :
      FBFStructuralCorrespondence
        S₁ S₂ C₁ C₂ s₁ s₂)
    (B A : InformationSet)
    (hReference :
      SolvabilityBiconditionalCriterion
        G₁ C₁ s₁ B A) :

    SolvabilityBiconditionalCriterion
      G₂
      C₂
      s₂
      (R.constructionIso.infoEquiv B)
      (R.constructionIso.infoEquiv A) := by

  exact
    (FBF_solvability_biconditionality_transfer
      R B A).mp hReference


-- ============================================
-- PART 15.6:
-- EXPLICIT EXPANDED FORM
-- ============================================

theorem FBF_symmetry_reversibility_transfer
    [InformationStructure]
    [BitDependency]
    [InformationEquivalence]
    {A₁ A₂ : InformationSet}
    {G₁ G₂ : Type v}
    [Group G₁]
    [Group G₂]
    {S₁ : FBFBitSymmetry A₁ G₁}
    {S₂ : FBFBitSymmetry A₂ G₂}
    {C₁ C₂ : FBFConstructionSystem}
    {s₁ s₂ : FObject}
    (R :
      FBFStructuralCorrespondence
        S₁ S₂ C₁ C₂ s₁ s₂)
    (B A : InformationSet)
    (hReference :
      Group.IsSolvable G₁ ↔
      EmergentBiconditional
        C₁ s₁ B A) :

    Group.IsSolvable G₂ ↔
    EmergentBiconditional
      C₂
      s₂
      (R.constructionIso.infoEquiv B)
      (R.constructionIso.infoEquiv A) := by

  exact
    FBF_transfer_from_reference_realization
      R B A hReference


